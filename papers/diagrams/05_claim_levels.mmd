flowchart BT
    E["Level 1 - Empirical findings<br/>observations under a protocol"]
    F["Level 2 - Formal models<br/>definitions, proofs, and mechanisms"]
    W["Level 3 - Working ontology<br/>structured becoming as interpretation"]
    A["Level 4 - Apophatic restraint<br/>no modeled term is absolute"]

    E -->|"may support"| F
    F -->|"may motivate"| W
    W -->|"is governed by"| A
    E -.->|"does not entail"| W
    F -.->|"does not entail"| A

    classDef empirical fill:#E8F5EC,stroke:#2F6B42,stroke-width:2px,color:#183923;
    classDef formal fill:#EAF2F8,stroke:#244A64,stroke-width:2px,color:#132D3D;
    classDef working fill:#FFF3D6,stroke:#A56A00,stroke-width:2px,color:#513500;
    classDef restraint fill:#F1ECF7,stroke:#6A4A86,stroke-width:2px,color:#362446;
    class E empirical;
    class F formal;
    class W working;
    class A restraint;

